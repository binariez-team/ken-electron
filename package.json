{
    "name": "kengroup",
    "version": "2.3.2",
    "description": "Kengroup Accounting System",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "rm -rf dist && electron-builder --x64 --win --publish always"
    },
    "build": {
        "appId": "com.binariez.Ja3farMortada.kengroup",
        "productName": "Kengroup",
        "artifactName": "${name}-${version}.${ext}",
        "target": "NSIS",
        "publish": [
            {
                "provider": "github",
                "owner": "binariez-team",
                "repo": "ken-electron",
                "releaseType": "release"
            }
        ],
        "directories": {
            "buildResources": "resources"
        },
        "extraResources": [
            "./server"
        ],
        "npmRebuild": "false"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/binariez-team/ken-electron.git"
    },
    "author": "Binariez LLC",
    "license": "ISC",
    "dependencies": {
        "bootstrap": "^5.3.3",
        "electron-context-menu": "^3.6.1",
        "electron-log": "^4.4.8",
        "electron-updater": "^6.1.1",
        "moment": "^2.29.4",
        "mysql2": "^3.6.0",
        "vue": "^3.5.28"
    },
    "devDependencies": {
        "electron": "^40.3.0",
        "electron-builder": "^26.7.0"
    }
}
